{
  "name": "@ykurilov/ds-tokens",
  "version": "0.2.1",
  "description": "Переменные YKDesignSystem: один источник для CSS, JS и SwiftUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ykurilov/YKDesignSystem.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/ykurilov/YKDesignSystem#readme",
  "bugs": {
    "url": "https://github.com/ykurilov/YKDesignSystem/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
