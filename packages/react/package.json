{
  "name": "@ykurilov/ds-react",
  "version": "0.2.0",
  "description": "React-компоненты YKDesignSystem на переменных @ykurilov/ds-tokens",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run && pnpm typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "@ykurilov/ds-tokens": "^0.2.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ykurilov/ds-tokens": "workspace:^",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
